{
  "name": "reviewer",
  "description": "Read-only pull request reviewer for this ERP repository. Reads the ticket, the diff and the PR body, writes one review to .ai-review/review.md for the caller to post. Never posts, never approves, never merges, never writes anywhere else.",
  "prompt": "file://reviewer.md",
  "model": "claude-sonnet-5.5",
  "tools": ["read", "write", "shell"],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://../../AGENTS.md",
    "file://../../apps/api/AGENTS.md",
    "file://../../apps/web/AGENTS.md",
    "skill://.kiro/skills/review-pr/SKILL.md"
  ],
  "permissions": {
    "rules": [
      { "capability": "fs_read", "match": ["./**"], "effect": "allow" },
      { "capability": "fs_write", "match": [".ai-review/**"], "effect": "allow" },
      {
        "capability": "fs_write",
        "match": ["./**"],
        "exclude": [".ai-review/**"],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "mkdir -p .ai-review*",
          "gh pr view *",
          "gh pr diff *",
          "gh pr checks *",
          "gh issue view *",
          "git log *",
          "git diff *",
          "git show *",
          "git fetch *",
          "git status*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "gh pr merge *",
          "gh pr review *",
          "gh pr comment *",
          "gh pr edit *",
          "gh pr close *",
          "gh issue close *",
          "gh issue edit *",
          "gh issue comment *",
          "gh api *",
          "git push *",
          "git commit *",
          "git checkout *",
          "git switch *",
          "pnpm *",
          "npx *"
        ],
        "effect": "deny"
      }
    ]
  },
  "hooks": [
    {
      "name": "agent-guard",
      "trigger": "PreToolUse",
      "matcher": "^(execute_bash|execute_pwsh)$",
      "action": { "type": "command", "command": "node scripts/agent-guard.mjs" }
    }
  ]
}
