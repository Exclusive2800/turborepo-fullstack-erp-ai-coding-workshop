// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// The TOR's four-role model (Section 2). ADMIN/Administrator, PURCHASING/Purchasing officer,
// STAFF/Store employee, MANAGER/Manager. Role says *what*; store assignment says *where*.
enum Role {
  ADMIN
  PURCHASING
  STAFF
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STAFF)
  /// The store a STAFF employee is pinned to. Null for cross-store roles (ADMIN, MANAGER, PURCHASING).
  assignedStoreId String?
  assignedStore   Store?  @relation(fields: [assignedStoreId], references: [id])
  /// Movements this user caused (#5 ledger). Append-only; a user is never deleted while referenced.
  movements    StockMovement[]
  /// Purchase orders this user created (#7). A creator referenced by an order is never deleted.
  createdPurchaseOrders PurchaseOrder[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model Store {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  users      User[]
  thresholds ProductStoreThreshold[]
  movements  StockMovement[]
  balances   StockBalance[]
  /// Purchase orders whose destination is this store (#7).
  purchaseOrders PurchaseOrder[]
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Purchase orders raised against this supplier (#7). A supplier referenced by an order stays.
  purchaseOrders PurchaseOrder[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

// A catalogue product (MD-01/MD-02). SKU is unique across the organization and cannot change
// once a transaction references the product — `skuLocked` is flipped by the transaction features
// in later tickets; the update handler refuses a SKU change while it is set. `active` controls
// whether the product may be added to a *new* document; deactivated products stay searchable in
// historical records (the list endpoint still returns them). Monetary values are two decimals.
model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  category     String
  unit         String
  sellingPrice Decimal  @db.Decimal(12, 2)
  active       Boolean  @default(true)
  /// Set once a transaction references this product, locking the SKU against edits.
  skuLocked    Boolean  @default(false)
  /// Per-store reorder thresholds (INV low-stock). One row per store that has a threshold set.
  thresholds   ProductStoreThreshold[]
  /// Append-only ledger of every stock change and the maintained per-store balances (#5).
  movements    StockMovement[]
  balances     StockBalance[]
  /// Purchase-order lines that reference this product (#7). A line keeps the link for receiving (#9).
  purchaseOrderLines PurchaseOrderLine[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

// A product's reorder threshold for one store. Thresholds are per-store (MD-01): the same product
// can reorder at a different level in each branch. Non-negative whole number.
model ProductStoreThreshold {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  threshold Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, storeId])
}

// Why a stock change happened (INV-02). An OPEN enum by design (spec #1): this release emits
// OPENING (seeded opening balances), ADJUSTMENT (#6), GOODS_RECEIPT (#7/#9) and SALE (#13/#14);
// deferred movement kinds (transfers, returns) can be added here without reshaping the ledger.
enum StockMovementType {
  OPENING
  ADJUSTMENT
  GOODS_RECEIPT
  SALE
}

// The append-only stock ledger (INV-02/03). One immutable row per stock change: it records the
// product, store, signed quantity change, the balance before and after, the movement type, the
// source document that caused it, the actor, and when. There is no updatedAt and no handler edits
// or deletes a row — history cannot be rewritten. `balance = opening + sum(qtyChange)` by
// construction. Every downstream document (adjustment, goods receipt, sale) posts through here.
model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id])
  /// Signed change applied to the balance: positive for a receipt, negative for a sale.
  qtyChange      Int
  /// Authoritative balance immediately before and after this movement was applied.
  balanceBefore  Int
  balanceAfter   Int
  type           StockMovementType
  /// The document that caused the change, e.g. "OPENING", a receipt or sale number. Snapshot text.
  sourceDocument String
  /// The mandatory manager reason for an ADJUSTMENT movement (INV-05); NULL for every other kind.
  reason         String?
  /// Who caused the movement (NULL only for system-seeded opening balances).
  actorId        String?
  actor          User?             @relation(fields: [actorId], references: [id])
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@index([productId, storeId])
  @@index([storeId, type])
}

// The current on-hand quantity for one product in one store (INV-01/03). Maintained transactionally
// from StockMovement rows inside the same transaction that writes the movement; never negative.
// One row per (product, store).
model StockBalance {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([productId, storeId])
}

// The unique document-number mechanism (Section 4.3). `IssuedDocumentNumber` holds every number
// ever handed out; its primary key is the number itself, so a second attempt to issue the same
// number is rejected by the database. `DocumentCounter` is the per-prefix running count that the
// allocator increments atomically to generate the next sequential number (e.g. GR-000001).
// Downstream tickets (#9 goods receipts, #14 sales) allocate through the shared helper.
model DocumentCounter {
  prefix    String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model IssuedDocumentNumber {
  number    String   @id
  prefix    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([prefix])
}

// The purchase-order lifecycle (PO-03, spec #1 "PO/GR state machine"). The FULL set is modelled now
// so #8 (the authoritative transition table) and #9 (goods receipt) can advance orders without
// reshaping the model. #7 only ever writes DRAFT; users never set status directly — only a valid
// transition (owned by #8) moves an order on from DRAFT.
//   DRAFT → PENDING_APPROVAL → APPROVED → PARTIALLY_RECEIVED → COMPLETED, plus REJECTED, CANCELLED.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

// A purchase order (PO-01/PO-02). A PURCHASING officer drafts an order for a supplier with a
// destination store, an expected receipt date and at least one line. `number` is the unique
// document number allocated at creation (Section 4.3). `status` starts at DRAFT; creating an order
// never moves stock (#7, PO-02). `total` is the sum of line totals, two-decimal money.
model PurchaseOrder {
  id                  String              @id @default(cuid())
  number              String              @unique
  status              PurchaseOrderStatus @default(DRAFT)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  storeId             String
  store               Store               @relation(fields: [storeId], references: [id])
  expectedReceiptDate DateTime            @db.Timestamptz(3)
  total               Decimal             @db.Decimal(12, 2)
  /// Who created the order (a PURCHASING officer). Kept for audit; never null for #7 orders.
  createdById         String?
  createdBy           User?               @relation(fields: [createdById], references: [id])
  lines               PurchaseOrderLine[]
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)

  @@index([supplierId])
  @@index([storeId])
  @@index([status])
}

// One line of a purchase order (PO-02, Section 4.3). `productName` and `unitPrice` are a SNAPSHOT
// taken at creation: later edits to the product master never rewrite a stored line. `lineTotal` is
// `quantity × unitPrice`. `productId`/`sku` keep the line linked to the catalogue for receiving (#9).
// Ordered quantity is a positive whole number; purchase unit price is non-negative money.
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  /// Snapshot of the product's SKU at creation (kept alongside the live link for display).
  sku             String
  /// Snapshot of the product's name at creation; never rewritten by a later master-data edit.
  productName     String
  quantity        Int
  /// Snapshot of the purchase unit price at creation, two-decimal money.
  unitPrice       Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([purchaseOrderId])
  @@index([productId])
}
